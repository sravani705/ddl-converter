      "mysql": {"target": "JSON", "review": "MySQL JSON type for variant data."},
      "oracle": {"target": "XMLTYPE or CLOB", "review": "Oracle lacks direct equivalent; use XMLTYPE or CLOB."},
      "postgresql": {"target": "JSON"},
      "db2": {"target": "CLOB"},
