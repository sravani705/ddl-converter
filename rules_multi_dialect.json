  "function_mappings": {
    "_comment": "Dialect-specific function mappings for DEFAULT expressions and other contexts.",

    "GETDATE": {
      "tsql": {"replacement": "GETDATE()"},
      "mysql": {"replacement": "NOW()"},
      "oracle": {"replacement": "SYSDATE"},
      "postgresql": {"replacement": "CURRENT_TIMESTAMP"},
      "db2": {"replacement": "CURRENT_TIMESTAMP"},
      "hana": {"replacement": "CURRENT_TIMESTAMP"},
      "snowflake": {"replacement": "CURRENT_TIMESTAMP()"}
    },

    "GETUTCDATE": {
      "tsql": {"replacement": "GETUTCDATE()", "review": "Ensure timezone handling is consistent."},
      "mysql": {"replacement": "UTC_TIMESTAMP()"},
      "oracle": {"replacement": "SYS_EXTRACT_UTC(SYSTIMESTAMP)", "review": "Oracle UTC extraction."},
      "postgresql": {"replacement": "CURRENT_TIMESTAMP AT TIME ZONE 'UTC'"},
      "db2": {"replacement": "CURRENT_TIMESTAMP"},
      "hana": {"replacement": "CURRENT_TIMESTAMP"},
      "snowflake": {"replacement": "CONVERT_TIMEZONE('UTC', CURRENT_TIMESTAMP())", "review": "Verify session timezone."}
    },

    "NEWID": {
      "tsql": {"replacement": "NEWID()", "review": "GUID generation algorithm differs."},
      "mysql": {"replacement": "UUID()"},
      "oracle": {"replacement": "DBMS_RANDOM.VALUE() -- or use sequence", "review": "Oracle lacks native GUID; use UUID package or sequence."},
      "postgresql": {"replacement": "gen_random_uuid()", "review": "Requires pgcrypto extension."},
      "db2": {"replacement": "GENERATE_UNIQUE()"},
      "hana": {"replacement": "SYSUUID"},
      "snowflake": {"replacement": "UUID_STRING()"}
    },

    "ISNULL": {
      "tsql": {"replacement": "ISNULL("},"mysql": {"replacement": "IFNULL("},
      "oracle": {"replacement": "NVL("},
      "postgresql": {"replacement": "COALESCE("},
      "db2": {"replacement": "COALESCE("},
      "hana": {"replacement": "COALESCE("},
      "snowflake": {"replacement": "COALESCE("}
    },

    "CURRENT_USER": {
      "tsql": {"replacement": "CURRENT_USER"},
      "mysql": {"replacement": "CURRENT_USER()"},
      "oracle": {"replacement": "USER"},
      "postgresql": {"replacement": "CURRENT_USER"},
      "db2": {"replacement": "CURRENT_USER"},
      "hana": {"replacement": "CURRENT_USER"},
      "snowflake": {"replacement": "CURRENT_USER()"}
    }
  },

  "identity_syntax": {
    "tsql": {
      "pattern": "IDENTITY\\s*\\(\\s*(-?\\d+)\\s*,\\s*(-?\\d+)\\s*\\)",
      "default_pattern": "IDENTITY\\b(?!\\s*\\()",
      "template": "IDENTITY({seed},{increment})",
      "template_default": "IDENTITY(1,1)"
    },
    "mysql": {
      "pattern": "AUTO_INCREMENT",
      "template": "AUTO_INCREMENT"
    },
    "oracle": {
      "pattern": "SEQUENCE",
      "template": "-- Oracle: Use CREATE SEQUENCE seq_name START WITH {seed} INCREMENT BY {increment};"
    },
    "postgresql": {
      "pattern": "SERIAL|BIGSERIAL",
      "template": "SERIAL"
    },
    "db2": {
      "pattern": "GENERATED.*AS IDENTITY",
      "template": "GENERATED ALWAYS AS IDENTITY (START WITH {seed} INCREMENT BY {increment})"
    },
    "hana": {
      "pattern": "CS_INT|GENERATED.*IDENTITY",
      "template": "-- HANA: Configure in table options"
    },
    "snowflake": {
      "pattern": "AUTOINCREMENT",
      "template": "AUTOINCREMENT START {seed} INCREMENT {increment}"
    }
  },

  "bit_literal_defaults": {
    "tsql": {
      "0": "0",
      "1": "1",
      "(0)": "0",
      "(1)": "1"
    },
    "mysql": {
      "0": "FALSE",
      "1": "TRUE"
    },
    "oracle": {
      "0": "0",
      "1": "1"
    },
    "postgresql": {
      "0": "false",
      "1": "true"
    },
    "db2": {
