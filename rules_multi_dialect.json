      "1": "true"
    },
    "snowflake": {
      "0": "FALSE",
      "1": "TRUE"
    }
  },

  "schema_handling": {
    "tsql": {"strip_schemas": ["dbo", "sys"]},
    "mysql": {"strip_schemas": ["mysql", "information_schema", "performance_schema"]},
    "oracle": {"strip_schemas": ["SYS", "SYSTEM"]},
    "postgresql": {"strip_schemas": ["pg_catalog", "information_schema", "public"]},
    "db2": {"strip_schemas": ["SYSCAT", "SYSFUN", "SYSIBM"]},
    "hana": {"strip_schemas": ["SYS", "CATALOG"]},
    "snowflake": {"strip_schemas": []}
  },

