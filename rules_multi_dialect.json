{
  "_comment": "Multi-dialect SQL DDL conversion rules. Supports MySQL, SQL Server, Oracle, PostgreSQL, IBM DB2, SAP HANA, Snowflake as source and/or target dialects. Each mapping specifies how a type/function is handled per dialect pair.",

  "metadata": {
    "version": "2.0",
    "supported_dialects": ["tsql", "mysql", "oracle", "postgresql", "db2", "hana", "snowflake"],
    "description": "Rules-driven conversion engine supporting multiple SQL dialects"
  },

  "type_mappings": {
    "_comment": "key = common base type (uppercase, dialect-agnostic). target = {dialect: {target_type, carry_args, fixed_args, review}}",

    "INT": {
      "tsql": {"target": "INT"},
      "mysql": {"target": "INT"},
      "oracle": {"target": "NUMBER(10,0)"},
      "postgresql": {"target": "INTEGER"},
      "db2": {"target": "INTEGER"},
      "hana": {"target": "INTEGER"},
      "snowflake": {"target": "INTEGER"}
    },

    "INTEGER": {
      "tsql": {"target": "INTEGER"},
      "mysql": {"target": "INT"},
      "oracle": {"target": "NUMBER(10,0)"},
      "postgresql": {"target": "INTEGER"},
      "db2": {"target": "INTEGER"},
      "hana": {"target": "INTEGER"},
      "snowflake": {"target": "INTEGER"}
    },

    "BIGINT": {
      "tsql": {"target": "BIGINT"},
      "mysql": {"target": "BIGINT"},
      "oracle": {"target": "NUMBER(19,0)"},
      "postgresql": {"target": "BIGINT"},
      "db2": {"target": "BIGINT"},
      "hana": {"target": "BIGINT"},
      "snowflake": {"target": "BIGINT"}
    },

    "SMALLINT": {
      "tsql": {"target": "SMALLINT"},
      "mysql": {"target": "SMALLINT"},
      "oracle": {"target": "NUMBER(5,0)"},
      "postgresql": {"target": "SMALLINT"},
      "db2": {"target": "SMALLINT"},
      "hana": {"target": "SMALLINT"},
      "snowflake": {"target": "SMALLINT"}
    },

    "TINYINT": {
      "tsql": {"target": "TINYINT", "review": "SQL Server TINYINT is unsigned 0-255; other databases have no exact equivalent. Choose appropriate target type and add range CHECK if needed."},
      "mysql": {"target": "TINYINT"},
      "oracle": {"target": "NUMBER(3,0)", "review": "Oracle has no TINYINT; mapped to NUMBER(3,0)."},
      "postgresql": {"target": "SMALLINT", "review": "PostgreSQL has no TINYINT; mapped to SMALLINT."},
      "db2": {"target": "SMALLINT", "review": "DB2 has no TINYINT; mapped to SMALLINT."},
      "hana": {"target": "TINYINT"},
      "snowflake": {"target": "SMALLINT", "review": "Snowflake has no unsigned types; mapped to SMALLINT."}
    },

    "BIT": {
      "tsql": {"target": "BIT"},
      "mysql": {"target": "BIT"},
      "oracle": {"target": "NUMBER(1,0)", "review": "Oracle uses NUMBER(1,0) for boolean-like values."},
      "postgresql": {"target": "BOOLEAN"},
      "db2": {"target": "SMALLINT", "review": "DB2 uses SMALLINT for boolean values."},
      "hana": {"target": "BOOLEAN"},
      "snowflake": {"target": "BOOLEAN"}
    },

    "VARCHAR": {
      "tsql": {"target": "VARCHAR", "carry_args": true},
      "mysql": {"target": "VARCHAR", "carry_args": true},
      "oracle": {"target": "VARCHAR2", "carry_args": true},
      "postgresql": {"target": "VARCHAR", "carry_args": true},
      "db2": {"target": "VARCHAR", "carry_args": true},
      "hana": {"target": "VARCHAR", "carry_args": true},
      "snowflake": {"target": "VARCHAR", "carry_args": true}
    },

    "NVARCHAR": {
      "tsql": {"target": "NVARCHAR", "carry_args": true, "max_alias": "MAX"},
      "mysql": {"target": "VARCHAR", "carry_args": true, "review": "MySQL VARCHAR is already Unicode; NVARCHAR is not a distinct type."},
      "oracle": {"target": "NVARCHAR2", "carry_args": true},
      "postgresql": {"target": "VARCHAR", "carry_args": true},
      "db2": {"target": "VARCHAR", "carry_args": true},
      "hana": {"target": "NVARCHAR", "carry_args": true},
      "snowflake": {"target": "VARCHAR", "carry_args": true}
    },

    "CHAR": {
      "tsql": {"target": "CHAR", "carry_args": true},
      "mysql": {"target": "CHAR", "carry_args": true},
      "oracle": {"target": "CHAR", "carry_args": true},
      "postgresql": {"target": "CHAR", "carry_args": true},
      "db2": {"target": "CHAR", "carry_args": true},
      "hana": {"target": "CHAR", "carry_args": true},
      "snowflake": {"target": "CHAR", "carry_args": true}
    },

    "NCHAR": {
      "tsql": {"target": "NCHAR", "carry_args": true},
      "mysql": {"target": "CHAR", "carry_args": true},
      "oracle": {"target": "NCHAR", "carry_args": true},
      "postgresql": {"target": "CHAR", "carry_args": true},
      "db2": {"target": "CHAR", "carry_args": true},
      "hana": {"target": "NCHAR", "carry_args": true},
      "snowflake": {"target": "CHAR", "carry_args": true}
    },

    "TEXT": {
      "tsql": {"target": "VARCHAR", "fixed_args": "MAX", "review": "TEXT is deprecated; mapped to max VARCHAR."},
      "mysql": {"target": "TEXT"},
      "oracle": {"target": "CLOB", "review": "Oracle CLOBs have different semantics than TEXT."},
      "postgresql": {"target": "TEXT"},
      "db2": {"target": "CLOB", "review": "DB2 CLOBs require different handling."},
      "hana": {"target": "NCLOB"},
      "snowflake": {"target": "VARCHAR", "fixed_args": "16777216"}
    },

    "DATETIME": {
      "tsql": {"target": "DATETIME"},
      "mysql": {"target": "DATETIME"},
      "oracle": {"target": "DATE", "review": "Oracle DATE includes time; behavior differs from SQL Server DATETIME."},
      "postgresql": {"target": "TIMESTAMP"},
      "db2": {"target": "TIMESTAMP"},
      "hana": {"target": "TIMESTAMP"},
      "snowflake": {"target": "TIMESTAMP"}
    },

    "DATETIME2": {
      "tsql": {"target": "DATETIME2"},
      "mysql": {"target": "DATETIME"},
      "oracle": {"target": "TIMESTAMP"},
      "postgresql": {"target": "TIMESTAMP"},
      "db2": {"target": "TIMESTAMP"},
      "hana": {"target": "TIMESTAMP"},
      "snowflake": {"target": "TIMESTAMP"}
    },

    "DATE": {
      "tsql": {"target": "DATE"},
      "mysql": {"target": "DATE"},
      "oracle": {"target": "DATE", "review": "Oracle DATE includes time; only date part will be used."},
      "postgresql": {"target": "DATE"},
      "db2": {"target": "DATE"},
      "hana": {"target": "DATE"},
      "snowflake": {"target": "DATE"}
    },

    "TIME": {
      "tsql": {"target": "TIME"},
      "mysql": {"target": "TIME"},
      "oracle": {"target": "INTERVAL DAY TO SECOND", "review": "Oracle uses INTERVAL for time representation."},
      "postgresql": {"target": "TIME"},
      "db2": {"target": "TIME"},
      "hana": {"target": "TIME"},
      "snowflake": {"target": "TIME"}
    },

    "DECIMAL": {
      "tsql": {"target": "DECIMAL", "carry_args": true},
      "mysql": {"target": "DECIMAL", "carry_args": true},
      "oracle": {"target": "NUMBER", "carry_args": true},
      "postgresql": {"target": "NUMERIC", "carry_args": true},
      "db2": {"target": "DECIMAL", "carry_args": true},
      "hana": {"target": "DECIMAL", "carry_args": true},
      "snowflake": {"target": "NUMBER", "carry_args": true}
    },

    "NUMERIC": {
      "tsql": {"target": "NUMERIC", "carry_args": true},
      "mysql": {"target": "DECIMAL", "carry_args": true},
      "oracle": {"target": "NUMBER", "carry_args": true},
      "postgresql": {"target": "NUMERIC", "carry_args": true},
      "db2": {"target": "DECIMAL", "carry_args": true},
      "hana": {"target": "DECIMAL", "carry_args": true},
      "snowflake": {"target": "NUMBER", "carry_args": true}
    },

    "NUMBER": {
      "tsql": {"target": "NUMBER", "carry_args": true, "review": "Mapped from Oracle/HANA NUMBER when encountered as base type."},
      "mysql": {"target": "DECIMAL", "carry_args": true},
      "oracle": {"target": "NUMBER", "carry_args": true},
      "postgresql": {"target": "NUMERIC", "carry_args": true},
      "db2": {"target": "DECIMAL", "carry_args": true},
      "hana": {"target": "NUMBER", "carry_args": true},
      "snowflake": {"target": "NUMBER", "carry_args": true}
    },

    "VARCHAR2": {
      "tsql": {"target": "VARCHAR", "carry_args": true},
      "mysql": {"target": "VARCHAR", "carry_args": true},
      "oracle": {"target": "VARCHAR2", "carry_args": true},
      "postgresql": {"target": "VARCHAR", "carry_args": true},
      "db2": {"target": "VARCHAR", "carry_args": true},
      "hana": {"target": "VARCHAR", "carry_args": true},
      "snowflake": {"target": "VARCHAR", "carry_args": true}
    },

    "BOOLEAN": {
      "tsql": {"target": "BOOLEAN", "review": "T-SQL typically uses BIT; BOOLEAN columns are rare but mapped if present."},
      "mysql": {"target": "BOOLEAN"},
      "oracle": {"target": "NUMBER(1,0)", "review": "Oracle does not support BOOLEAN as a column type in SQL; often represented as NUMBER(1,0) or CHAR(1)."},
      "postgresql": {"target": "BOOLEAN"},
      "db2": {"target": "SMALLINT", "review": "DB2 often models boolean as SMALLINT or CHAR(1)."},
      "hana": {"target": "BOOLEAN"},
      "snowflake": {"target": "BOOLEAN"}
    },

    "TIMESTAMP": {
      "tsql": {"target": "TIMESTAMP"},
      "mysql": {"target": "TIMESTAMP"},
      "oracle": {"target": "TIMESTAMP", "review": "Oracle TIMESTAMP behavior differs from DATE; confirm precision."},
      "postgresql": {"target": "TIMESTAMP"},
      "db2": {"target": "TIMESTAMP"},
      "hana": {"target": "TIMESTAMP"},
      "snowflake": {"target": "TIMESTAMP"}
    },

    "SERIAL": {
      "tsql": {"target": "INTEGER", "review": "T-SQL has no SERIAL; map to INTEGER and add identity handling separately."},
      "mysql": {"target": "INTEGER", "review": "MySQL AUTO_INCREMENT is preferred; SERIAL maps to INTEGER with AUTO_INCREMENT behavior."},
      "oracle": {"target": "NUMBER(10,0)", "review": "Oracle uses sequences; SERIAL mapped to NUMBER."},
      "postgresql": {"target": "SERIAL", "review": "Postgres SERIAL should be converted to a sequence or IDENTITY/AUTOINCREMENT on target."},
      "db2": {"target": "INTEGER"},
      "hana": {"target": "INTEGER"},
      "snowflake": {"target": "INTEGER", "review": "SERIAL is sequence-backed; convert to AUTOINCREMENT or recreate sequence+default in Snowflake."}
    },

    "FLOAT": {
      "tsql": {"target": "FLOAT"},
      "mysql": {"target": "FLOAT"},
      "oracle": {"target": "FLOAT"},
      "postgresql": {"target": "DOUBLE PRECISION"},
      "db2": {"target": "DOUBLE"},
      "hana": {"target": "DOUBLE"},
      "snowflake": {"target": "FLOAT"}
    },

    "REAL": {
      "tsql": {"target": "REAL", "review": "REAL is 32-bit; precision may differ across databases."},
      "mysql": {"target": "FLOAT"},
      "oracle": {"target": "FLOAT"},
      "postgresql": {"target": "REAL"},
      "db2": {"target": "REAL"},
      "hana": {"target": "REAL"},
      "snowflake": {"target": "FLOAT", "review": "Snowflake FLOAT is 64-bit double; different precision than SQL Server REAL."}
    },

    "MONEY": {
      "tsql": {"target": "MONEY", "review": "MONEY is SQL Server-specific; convert to DECIMAL/NUMBER with fixed precision."},
      "mysql": {"target": "DECIMAL", "fixed_args": "19,4"},
      "oracle": {"target": "NUMBER", "fixed_args": "19,4"},
      "postgresql": {"target": "NUMERIC", "fixed_args": "19,4"},
      "db2": {"target": "DECIMAL", "fixed_args": "19,4"},
      "hana": {"target": "DECIMAL", "fixed_args": "19,4"},
      "snowflake": {"target": "NUMBER", "fixed_args": "19,4"}
    },

    "SMALLMONEY": {
      "tsql": {"target": "SMALLMONEY"},
      "mysql": {"target": "DECIMAL", "fixed_args": "10,4"},
      "oracle": {"target": "NUMBER", "fixed_args": "10,4"},
      "postgresql": {"target": "NUMERIC", "fixed_args": "10,4"},
      "db2": {"target": "DECIMAL", "fixed_args": "10,4"},
      "hana": {"target": "DECIMAL", "fixed_args": "10,4"},
      "snowflake": {"target": "NUMBER", "fixed_args": "10,4"}
    },

    "UNIQUEIDENTIFIER": {
      "tsql": {"target": "UNIQUEIDENTIFIER", "review": "Implement GUID generation manually."},
      "mysql": {"target": "CHAR", "fixed_args": "36", "review": "MySQL stores GUIDs as VARCHAR(36)."},
      "oracle": {"target": "RAW", "fixed_args": "16", "review": "Oracle RAW(16) stores binary UUIDs."},
      "postgresql": {"target": "UUID", "review": "PostgreSQL has native UUID type; consider using uuid-ossp extension."},
      "db2": {"target": "CHAR", "fixed_args": "36"},
      "hana": {"target": "NVARCHAR", "fixed_args": "36"},
      "snowflake": {"target": "VARCHAR", "fixed_args": "36"}
    },

    "VARBINARY": {
