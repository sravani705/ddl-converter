      "oracle": {"target": "RAW", "carry_args": true},
      "postgresql": {"target": "BYTEA"},
      "db2": {"target": "VARCHAR FOR BIT DATA", "carry_args": true},
      "hana": {"target": "VARBINARY", "carry_args": true},
